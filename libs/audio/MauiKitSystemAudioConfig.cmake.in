@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6 @REQUIRED_QT_VERSION@ COMPONENTS Core DBus Gui Qml Quick)
find_dependency(KF6 @REQUIRED_KF_VERSION@ COMPONENTS I18n Notifications)
find_dependency(PkgConfig)
pkg_check_modules(LIBPIPEWIRE REQUIRED IMPORTED_TARGET libpipewire-0.3)

# Any changes in this ".cmake" file will be overwritten by CMake, the source is the ".cmake.in" file.

set(MauiKitSystemAudio_INSTALL_PREFIX "@PACKAGE_CMAKE_INSTALL_PREFIX@")

include("${CMAKE_CURRENT_LIST_DIR}/MauiKitSystemAudioTargets.cmake")

@PACKAGE_INCLUDE_QCHTARGETS@
