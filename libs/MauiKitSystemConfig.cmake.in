@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6Core @REQUIRED_QT_VERSION@)

# Any changes in this ".cmake" file will be overwritten by CMake, the source is the ".cmake.in" file.

foreach(PKG IN LISTS MauiKitSystem_FIND_COMPONENTS)
    find_package(MauiKitSystem${PKG})
    if(MauiKitSystem_FIND_REQUIRED_${PKG})
        set_package_properties(MauiKitSystem${PKG} PROPERTIES TYPE REQUIRED)
    else()
        set_package_properties(MauiKitSystem${PKG} PROPERTIES TYPE OPTIONAL)
    endif()

    set(MauiKitSystem_${PKG}_FOUND ${MauiKitSystem${PKG}_FOUND})
endforeach()

#include("${CMAKE_CURRENT_LIST_DIR}/MauiKitSystemTargets.cmake")

set(MauiKitSystem_INSTALL_PREFIX "@PACKAGE_CMAKE_INSTALL_PREFIX@")

@PACKAGE_INCLUDE_QCHTARGETS@
