@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
find_dependency(Qt6Core @REQUIRED_QT_VERSION@)
find_dependency(Qt6DBus @REQUIRED_QT_VERSION@)
find_dependency(KF6 @REQUIRED_KF_VERSION@ COMPONENTS NetworkManagerQt ModemManagerQt)
find_dependency(QCoro6 COMPONENTS Core)
find_dependency(Qt6Qml @REQUIRED_QT_VERSION@)
find_dependency(PkgConfig)
pkg_check_modules(NETWORKMANAGER REQUIRED IMPORTED_TARGET libnm)

set(MauiKitSystemNetwork_INSTALL_PREFIX "@PACKAGE_CMAKE_INSTALL_PREFIX@")

# Any changes in this ".cmake" file will be overwritten by CMake, and should be made in the ".cmake.in" source file.

include("${CMAKE_CURRENT_LIST_DIR}/MauiKitSystemNetworkTargets.cmake")

@PACKAGE_INCLUDE_QCHTARGETS@
